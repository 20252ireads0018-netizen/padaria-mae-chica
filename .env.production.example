# Copie para .env no servidor (cPanel) e preencha os dados do banco MySQL criado no cPanel.
APP_NAME="Mãe Chica"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://padaria.seudominio.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL do cPanel (o nome do banco e do usuário costumam ter o prefixo da conta: conta_padaria)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=conta_padaria
DB_USERNAME=conta_padaria
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Primeiro acesso da gerência (usado pelo ProductionSeeder; pode apagar depois)
ADMIN_NAME="Gerência Mãe Chica"
ADMIN_EMAIL=
ADMIN_PASSWORD=
